# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.

# ENTSO-E Transparency Platform API token.
# Get one at: https://transparency.entsoe.eu → My Account → Web API Security Token
ENTSOE_API_TOKEN=

# AWS credentials for S3 access (or use an IAM role on EC2/ECS).
# Local dev: easiest to use `aws configure` and let boto3 find them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1

# Snowflake — used by dbt and by the Airflow load job.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ENERGY_RAW
SNOWFLAKE_SCHEMA=PUBLIC

# S3 bucket where Iceberg tables live.
S3_BUCKET=aramis-eu-electricity-analytics
